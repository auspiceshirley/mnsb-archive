---
// src/components/Bilibili.astro
import Card from "./Card.astro";

export interface Props {
  id?: string;
  bvid?: string;
  aid?: number | string;
  cid?: number | string;
  page?: number | string;
  p?: number | string;
  highQuality?: boolean;
  danmaku?: boolean;
  autoplay?: boolean;
  muted?: boolean;
  poster?: boolean;
  t?: number | string;
  title?: string;
  class?: string;
  style?: string | Record<string, any>;
  lite?: boolean;
  [key: string]: any;
}

const {
  id,
  bvid,
  aid,
  cid,
  page,
  p,
  highQuality = true,
  danmaku = true,
  autoplay = false,
  muted = false,
  poster = true,
  t,
  title: propTitle = "Bilibili Video Player",
  class: className = "",
  style,
  lite = true,
  ...restProps
} = Astro.props;

let finalBvid = bvid;
let finalAid = aid;

if (!finalBvid && !finalAid && id) {
  const strId = String(id).trim();
  if (strId.toLowerCase().startsWith("av")) {
    finalAid = strId.slice(2);
  } else {
    finalBvid = strId;
  }
}

let videoData: any = null;
let errorMessage: string | null = null;

const hasVideoId = Boolean(finalBvid || finalAid);

if (!hasVideoId) {
  errorMessage = "Invalid video parameter.";
} else {
  try {
    const paramStr = finalBvid ? "bvid=" + finalBvid : "aid=" + finalAid;
    const apiUrl = "https://api.bilibili.com/x/web-interface/view?" + paramStr;
    const resp = await fetch(apiUrl, {
      headers: {
        "User-Agent":
          "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
      },
    });
    if (resp.ok) {
      const json = await resp.json();
      if (json.code === 0) {
        videoData = json.data;
      } else {
        errorMessage = "This video is unavailable.";
      }
    } else {
      errorMessage = "This video is unavailable.";
    }
  } catch {
    errorMessage = "This video is unavailable.";
  }
}

const videoTitle = videoData?.title || propTitle;
const coverUrl = videoData?.pic
  ? videoData.pic.replace(/^http:/, "https:")
  : "";
const owner = videoData?.owner || null;
const ownerName = owner?.name || "";
const ownerFace = owner?.face ? owner.face.replace(/^http:/, "https:") : "";
const ownerMid = owner?.mid || "";
const videoDesc = videoData?.desc || "";
const descHtml = videoDesc.replace(/\n/g, "<br/>");

const rawPage = page ?? p;
const targetPage =
  rawPage !== undefined ? parseInt(String(rawPage), 10) : undefined;

const params = new URLSearchParams();

if (finalBvid) {
  params.set("bvid", String(finalBvid));
} else if (finalAid) {
  params.set("aid", String(finalAid));
}
if (cid) params.set("cid", String(cid));
if (targetPage && targetPage > 1) params.set("p", String(targetPage));

params.set("high_quality", highQuality ? "1" : "0");
params.set("danmaku", danmaku ? "1" : "0");
params.set("autoplay", autoplay ? "1" : "0");
params.set("muted", muted ? "1" : "0");
params.set("poster", poster ? "1" : "0");
if (t !== undefined && t !== "") params.set("t", String(t));

const iframeSrc =
  "https://player.bilibili.com/player.html?" + params.toString();

const useLite = lite && videoData && !errorMessage;
---

<div class="bilibili-wrapper">
  {
    errorMessage ? (
      <div
        class:list={[
          "astro-embed",
          "astro-embed-bilibili",
          "error-mode",
          className,
        ]}
        style={style}
      >
        <div class="error-container">
          <div class="error-code">404</div>
          <div class="error-msg">{errorMessage}</div>
        </div>
      </div>
    ) : useLite ? (
      <div
        class:list={[
          "astro-embed",
          "astro-embed-bilibili",
          "lite-mode",
          className,
        ]}
        style={style}
        data-bvid={finalBvid || ""}
        data-aid={finalAid || ""}
        data-iframe-src={iframeSrc}
      >
        <div
          class="lite-preview"
          role="button"
          tabindex="0"
          aria-label="Play video"
        >
          <div class="cover-image" data-src={coverUrl} data-alt={videoTitle}>
            Image preview requires accepting third-party cookies.
          </div>
          <div class="gradient-overlay" />
          <div class="info-bottom">
            <div class="title">{videoTitle}</div>
            {ownerMid && ownerName && (
              <a
                href={"https://space.bilibili.com/" + ownerMid}
                rel="noopener noreferrer"
                class="author"
                title={ownerName}
                onclick="event.stopPropagation();"
              >
                {ownerFace && (
                  <span
                    class="avatar"
                    data-src={ownerFace}
                    data-alt={ownerName}
                  />
                )}
                <span class="name">{ownerName}</span>
              </a>
            )}
          </div>
          <button class="play-button" aria-label="Play">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="24"
              height="24"
            >
              <circle
                cx="12"
                cy="12"
                r="11"
                fill="#f5f5f5"
                stroke="#d0d0d0"
                stroke-width="1"
              />
              <path
                d="M 9.5 7.5 L 16.5 12 L 9.5 16.5 Z"
                fill="#333333"
                stroke="none"
              />
            </svg>
          </button>
        </div>

        <div class="iframe-wrapper" style="display: none;">
          <iframe
            src=""
            title={videoTitle}
            scrolling="no"
            allowfullscreen
            loading="lazy"
            {...restProps}
          />
        </div>
      </div>
    ) : (
      <div
        class:list={[
          "astro-embed",
          "astro-embed-bilibili",
          "direct-mode",
          className,
        ]}
        style={style}
      >
        <iframe
          data-src={iframeSrc}
          src=""
          title={propTitle}
          scrolling="no"
          allowfullscreen
          loading="lazy"
          {...restProps}
        />
      </div>
    )
  }

  {
    descHtml && (
      <div class="video-description">
        <Card title="Description">
          <div set:html={descHtml} style="font-size: 1rem;" />
        </Card>
      </div>
    )
  }
</div>

<script is:inline src="/scripts/bilibili-embed.js"></script>

<style>
  .bilibili-wrapper {
    width: 100%;
    max-width: 100%;
    margin: 1.5rem auto;
  }

  .astro-embed-bilibili {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--link-preview-placeholder-bg, rgba(0, 0, 0, 0.05));
    overflow: hidden;
    contain: layout style;
    height: auto;
    margin: 0 auto;
    border-radius: 8px;
  }

  .astro-embed-bilibili.error-mode {
    cursor: default;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .error-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    user-select: none;
  }

  .error-code {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: #71717a;
    letter-spacing: 0.05em;
  }

  .error-msg {
    font-size: 0.95rem;
    margin-top: 0.5rem;
    color: #a1a1aa;
  }

  .video-description {
    width: 100%;
    margin-top: 2rem;
  }

  .astro-embed-bilibili iframe,
  .lite-mode .iframe-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    margin: 0 !important;
    padding: 0 !important;
    border: 0;
    display: block;
  }

  .lite-mode .lite-preview {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: transparent;
  }

  .lite-mode :global(div.cover-image) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--link-preview-placeholder-color, #666);
    font-size: 0.85rem;
    background-color: var(--link-preview-placeholder-bg, rgba(0, 0, 0, 0.05));
  }

  .lite-mode :global(img.cover-image) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    padding: 0 !important;
    margin: 0 !important;
    border: none;
    transition: transform 0.3s ease;
  }

  .lite-mode .lite-preview:hover :global(.cover-image) {
    transform: scale(1.03);
  }

  .lite-mode .gradient-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
    pointer-events: none;
  }

  .lite-mode .info-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.2rem 1rem 1rem;
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    z-index: 1;
  }

  .lite-mode .title {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    margin: 0;
  }

  .lite-mode .author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    opacity: 0.9;
    transition: opacity 0.2s;
    width: fit-content;
  }

  .lite-mode .author:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .lite-mode :global(.avatar) {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: #ccc;
    flex-shrink: 0;
    margin: 0 !important;
  }

  .lite-mode .name {
    white-space: nowrap;
    max-width: 150px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lite-mode .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 68px;
    height: 48px;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: transform 0.2s;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    pointer-events: auto;
  }

  .lite-mode .play-button:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .lite-mode .play-button svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
  }

  .lite-mode .iframe-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    margin: 0 !important;
    padding: 0 !important;
    z-index: 3;
  }

  @media (max-width: 480px) {
    .astro-embed-bilibili {
      aspect-ratio: 16 / 9;
      height: auto;
    }
    .error-code {
      font-size: 2.2rem;
    }
    .error-msg {
      font-size: 0.85rem;
    }
    .lite-mode .title {
      font-size: 0.95rem;
    }
    .lite-mode .info-bottom {
      padding: 0.8rem 0.6rem 0.6rem;
    }
    .lite-mode .play-button {
      width: 56px;
      height: 40px;
    }
    .lite-mode :global(.avatar) {
      width: 20px;
      height: 20px;
    }
    .lite-mode .name {
      max-width: 100px;
    }
  }
</style>
