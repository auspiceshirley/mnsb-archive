---
// src/components/Pagination.astro
import { getCollection } from "astro:content";

const t = Astro.locals.t as unknown as (key: string) => string;

const pathname = Astro.url.pathname;
const normalizedPath = pathname.endsWith("/")
  ? pathname.slice(0, -1)
  : pathname;
const segments = normalizedPath.split("/").filter(Boolean);

const currentPageStr = segments[segments.length - 1] || "";
const currentPage = parseInt(currentPageStr, 10);
const isNumberedPage = !isNaN(currentPage);

const parentSegments = segments.slice(0, -1);
const parentPath = "/" + parentSegments.join("/");

const currentSlug =
  Astro.props.entry?.slug || Astro.props.slug || segments.join("/");
const currentSlugSegments = currentSlug.split("/").filter(Boolean);
currentSlugSegments.pop();
const currentDirSlug = currentSlugSegments.join("/");

const allDocs = await getCollection("docs");

const sameDirPageNumbers = allDocs
  .map((doc) => {
    const rawId =
      doc.id || ("slug" in doc ? (doc as Record<string, any>).slug : "");
    const docPath = rawId.replace(/\.(mdx?|md)$/, "");
    const docSegments = docPath.split("/").filter(Boolean);
    const fileName = docSegments.pop() || "";
    const dirSlug = docSegments.join("/");
    const pageNum = parseInt(fileName, 10);

    return { dirSlug, pageNum };
  })
  .filter((item) => item.dirSlug === currentDirSlug && !isNaN(item.pageNum))
  .map((item) => item.pageNum)
  .sort((a, b) => a - b);

const totalPages =
  sameDirPageNumbers.length > 0 ? Math.max(...sameDirPageNumbers) : 0;

function getPaginationRange(current: number, total: number, delta = 2) {
  if (total <= 1) return [1];
  const range: (number | string)[] = [];
  const left = current - delta;
  const right = current + delta + 1;

  for (let i = 1; i <= total; i++) {
    if (i === 1 || i === total || (i >= left && i < right)) {
      range.push(i);
    } else if (range[range.length - 1] !== "...") {
      range.push("...");
    }
  }
  return range;
}

const paginationRange = isNumberedPage
  ? getPaginationRange(currentPage, totalPages)
  : [];

const getPageUrl = (num: number) => `${parentPath}/${num}/`;
---

{
  isNumberedPage && totalPages > 0 && (
    <nav
      class="custom-pagination"
      aria-label="Pagination"
      data-parent-path={parentPath}
      data-total-pages={totalPages}
    >
      {currentPage > 1 ? (
        <a href={getPageUrl(1)} class="nav-item">
          {t("customPagination.first")}
        </a>
      ) : (
        <span class="nav-item disabled">{t("customPagination.first")}</span>
      )}

      {currentPage > 1 ? (
        <a href={getPageUrl(currentPage - 1)} class="nav-item">
          {t("customPagination.prev")}
        </a>
      ) : (
        <span class="nav-item disabled">{t("customPagination.prev")}</span>
      )}

      {paginationRange.map((item) => {
        if (item === "...") {
          return <span class="nav-item ellipsis">...</span>;
        }
        const num = item as number;
        const isCurrent = num === currentPage;
        return isCurrent ? (
          <span class="nav-item active" aria-current="page">
            {num}
          </span>
        ) : (
          <a href={getPageUrl(num)} class="nav-item">
            {num}
          </a>
        );
      })}

      {currentPage < totalPages ? (
        <a href={getPageUrl(currentPage + 1)} class="nav-item">
          {t("customPagination.next")}
        </a>
      ) : (
        <span class="nav-item disabled">{t("customPagination.next")}</span>
      )}

      {currentPage < totalPages ? (
        <a href={getPageUrl(totalPages)} class="nav-item">
          {t("customPagination.last")}
        </a>
      ) : (
        <span class="nav-item disabled">{t("customPagination.last")}</span>
      )}

      <div class="jump-container">
        <span class="jump-label">{t("customPagination.jumpTo")}</span>
        <input
          type="number"
          class="jump-input"
          min="1"
          max={totalPages}
          aria-label="Jump to a specific page number"
        />
        <span class="jump-label">{t("customPagination.pageUnit")}</span>
        <button type="button" class="nav-item jump-btn">
          {t("customPagination.go")}
        </button>
      </div>
    </nav>
  )
}

<script>
  function initPaginationJump() {
    const paginations =
      document.querySelectorAll<HTMLElement>(".custom-pagination");

    paginations.forEach((container) => {
      const parentPath = container.dataset.parentPath;
      const totalPages = parseInt(container.dataset.totalPages || "0", 10);
      const input = container.querySelector<HTMLInputElement>(".jump-input");
      const btn = container.querySelector<HTMLButtonElement>(".jump-btn");

      if (!input || !btn || !parentPath || totalPages <= 0) return;

      const executeJump = () => {
        const rawValue = parseInt(input.value, 10);
        if (isNaN(rawValue)) return;

        const targetPage = Math.min(Math.max(1, rawValue), totalPages);
        window.location.href = `${parentPath}/${targetPage}/`;
      };

      input.addEventListener("input", () => {
        const val = parseInt(input.value, 10);
        if (val > totalPages) {
          input.value = String(totalPages);
        }
      });

      btn.addEventListener("click", executeJump);

      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          executeJump();
        }
      });
    });
  }

  initPaginationJump();
  document.addEventListener("astro:page-load", initPaginationJump);
</script>

<style>
  .custom-pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    /* border-top: 1px solid var(--sl-color-hairline, #e5e7eb); */
    font-size: 0.875rem;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.625rem;
    border: 1px solid var(--sl-color-gray-5, #d1d5db);
    border-radius: 0.25rem;
    color: var(--sl-color-text, #374151);
    text-decoration: none;
    background-color: var(--sl-color-bg-inline-code, #ffffff);
    font-size: 0.875rem;
    box-sizing: border-box;
    transition: all 0.15s ease;
  }

  a.nav-item:hover,
  button.nav-item:hover {
    border-color: var(--sl-color-text-accent, #3b82f6);
    color: var(--sl-color-text-accent, #3b82f6);
    background-color: var(--sl-color-gray-6, #f3f4f6);
    cursor: pointer;
  }

  .nav-item.active {
    border-color: var(--sl-color-text-accent, #3b82f6);
    background-color: var(--sl-color-text-accent, #3b82f6);
    color: var(--sl-color-black, #ffffff);
    font-weight: 600;
  }

  .nav-item.disabled {
    opacity: 0.4;
    cursor: not-allowed;
    border-color: var(--sl-color-gray-5, #e5e7eb);
  }

  .nav-item.ellipsis {
    border: none;
    background: transparent;
    min-width: auto;
    padding: 0 0.25rem;
  }

  .jump-container {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-left: 0.25rem;
  }

  .jump-label {
    font-size: 0.875rem;
    color: var(--sl-color-text, #374151);
  }

  .jump-input {
    width: 3rem;
    height: 2.25rem;
    padding: 0 0.25rem;
    text-align: center;
    border: 1px solid var(--sl-color-gray-5, #d1d5db);
    border-radius: 0.25rem;
    color: var(--sl-color-text, #374151);
    background-color: var(--sl-color-bg-inline-code, #ffffff);
    font-size: 0.875rem;
    font-family: inherit;
    box-sizing: border-box;
    outline: none;
    transition: all 0.15s ease;
  }

  .jump-input:focus {
    border-color: var(--sl-color-text-accent, #3b82f6);
    background-color: var(--sl-color-bg, #ffffff);
  }

  .jump-input::-webkit-outer-spin-button,
  .jump-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .jump-input[type="number"] {
    -moz-appearance: textfield;
  }

  .jump-btn {
    font-weight: 600;
    min-width: auto;
    padding: 0 0.625rem;
  }
</style>
